# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-exe
dist-ssr
*.local

# The single-file build IS a deliverable, so index.html is tracked and kept current by
# .githooks/pre-commit. Everything else in dist-single/ is a copy of public/ — ignored,
# because tracking a second copy of a 190KB JPEG buys nothing.
dist-single/*
!dist-single/index.html

# Debugging screenshots and source archives at the repo root. Untracked noise here is
# exactly why six deleted public/ assets went unnoticed.
/test-*.png
/*.zip

# Playwright MCP screenshots
.playwright-mcp/

# Windows reserved names
nul

# Vite cache
.vite/

